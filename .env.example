APP_NAME="SDIT Raudhatul Jannah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database: SQLite (bawaan, file database/database.sqlite) atau MySQL
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portal_sekolah
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Akun admin pertama (dipakai oleh: php artisan db:seed). Isi sebelum menjalankan.
ADMIN_NAME="Admin Sekolah"
ADMIN_EMAIL=admin@raudhatuljannah.or.id
ADMIN_PASSWORD=
